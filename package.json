{
  "name": "rust-tutor",
  "version": "0.1.0",
  "private": true,
  "description": "Editor-centric Rust language tutor (rustc + rustfmt only) with CE-lane hints, review and judge",
  "type": "module",
  "engines": { "node": ">=22.13" },
